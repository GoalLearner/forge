# Dependencies
node_modules/

# Build and packaging output.
#   dist/    — tsup bundles + the copied renderer (`npm run build`)
#   release/ — electron-builder output; currently 476 MB including a 215 MB
#              Forge.exe and the 99 MB NSIS installer. Regenerated by
#              `npm run dist:app`; never a source of truth.
dist/
release/
out/
coverage/
*.tsbuildinfo

# Source maps are emitted next to the bundles and are pure build output.
*.map

# GENERATED packaging asset — deliberately ignored, not an oversight.
# `scripts/make-icon.mjs` (tracked) draws this deterministically, `npm run icon`
# regenerates it, and `dist:app` runs that BEFORE electron-builder, so packaging
# never depends on a committed copy. The generator is the canonical artefact.
# The rest of build/ is electron-builder's `buildResources` dir and stays
# tracked if anything non-generated is ever added to it.
build/icon.ico

# Logs and diagnostics
*.log
logs/
crash-reports/

# Environment and credentials.
# No .env or key material exists in this tree today (audited); these are
# preventive. `.env.example` is deliberately allowed through so a placeholder
# template can be committed later.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt

# Local Forge state.
# The real runtime state lives in ~/.forge/ (session DB, keys.json, ui.json,
# desktop.log) — outside this tree entirely. `.forge/` here is the PER-PROJECT
# directory: permissions.json records one machine's trust decisions about which
# shell commands were approved, so it must never follow the repo.
.forge/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Temporary and cache
tmp/
temp/
.cache/
*.tmp

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors / local agent state.
# Note the narrow scope: only the machine-local settings file is ignored, NOT
# `.claude/` as a whole — that directory can legitimately hold project
# instructions meant to guide coding agents, which belong in the repo.
.vscode/
.idea/
*.swp
.claude/settings.local.json
