 export interface Rate {
   code: string;
   perMille: number;
+  region?: string;
 }
 
 /** Sum of every rate in the list. Returns 0 for an empty list. */
 export function total(rs: Rate[]): number {
   return rs.reduce((sum, r) => sum + r.perMille, 0);
 }
+
+/** Bucket rates by region. Entries with no region go under "unknown". */
+export function groupByRegion(rs: Rate[]): Record<string, Rate[]> {
+  const groups: Record<string, Rate[]> = {};
+  for (const r of rs) {
+    const key = r.region ?? 'unknown';
+    (groups[key] ??= []).push(r);
+  }
+  return groups;
+}
+
+/** Sum of perMille for each region, using total(). */
+export function totalByRegion(rs: Rate[]): Record<string, number> {
+  const groups = groupByRegion(rs);
+  const totals: Record<string, number> = {};
+  for (const [region, rates] of Object.entries(groups)) {
+    totals[region] = total(rates);
+  }
+  return totals;
+}
