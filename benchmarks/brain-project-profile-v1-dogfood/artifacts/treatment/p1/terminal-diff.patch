@@ -14,3 +14,25 @@ test('mean averages several values', () => {
 test('mean throws on an empty list', () => {
   assert.throws(() => mean([]), /empty/);
 });
+
+test('median of a single value is the value', () => {
+  assert.equal(median([7]), 7);
+});
+
+test('median of an odd-length array returns the middle value', () => {
+  assert.equal(median([3, 1, 2]), 2);
+});
+
+test('median of an even-length array averages the two middle values', () => {
+  assert.equal(median([1, 2, 3, 4]), 2.5);
+});
+
+test('median does not mutate the input', () => {
+  const arr = [5, 1, 3];
+  median(arr);
+  assert.deepEqual(arr, [5, 1, 3]);
+});
+
+test('median throws on an empty list', () => {
+  assert.throws(() => median([]), /empty/);
+});
