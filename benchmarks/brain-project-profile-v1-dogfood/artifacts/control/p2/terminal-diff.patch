diff --git a/src/clamp.ts b/src/clamp.ts
index 838676b..1a2ee68 100644
--- a/src/clamp.ts
+++ b/src/clamp.ts
@@ -4,3 +4,9 @@ export function clamp(value: number, min: number, max: number): number {
   if (min > max) throw new Error('clamp: min must not exceed max');
   return value < min ? min : value > max ? max : value;
 }
+
+export function wrapRange(value: number, min: number, max: number): number {
+  if (min >= max) throw new Error('wrapRange: min must be less than max');
+  const range = max - min;
+  return ((((value - min) % range) + range) % range) + min;
+}
diff --git a/test/clamp.unit.test.ts b/test/clamp.unit.test.ts
index d4e1e21..d2d5451 100644
--- a/test/clamp.unit.test.ts
+++ b/test/clamp.unit.test.ts
@@ -1,7 +1,7 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
 
-import { clamp } from '../src/clamp.ts';
+import { clamp, wrapRange } from '../src/clamp.ts';
 
 test('clamp passes through an in-range value', () => {
   assert.equal(clamp(3, 0, 5), 3);
@@ -15,3 +15,23 @@ test('clamp pins to the bounds', () => {
 test('clamp rejects an inverted range', () => {
   assert.throws(() => clamp(1, 5, 0), /min/);
 });
+
+test('wrapRange passes through an in-range value', () => {
+  assert.equal(wrapRange(3, 0, 5), 3);
+});
+
+test('wrapRange wraps a value above the range', () => {
+  assert.equal(wrapRange(7, 0, 5), 2);
+});
+
+test('wrapRange wraps a negative value', () => {
+  assert.equal(wrapRange(-1, 0, 5), 4);
+});
+
+test('wrapRange wraps a value exactly at the upper bound', () => {
+  assert.equal(wrapRange(5, 0, 5), 0);
+});
+
+test('wrapRange rejects min >= max', () => {
+  assert.throws(() => wrapRange(1, 5, 5), /min/);
+});
